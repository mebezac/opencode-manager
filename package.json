{
  "name": "opencode-manager",
  "version": "2.0.4",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": []
  },
  "scripts": {
    "predev": "bash scripts/setup-dev.sh",
    "dev": "concurrently \"pnpm:dev:backend\" \"pnpm:dev:frontend\"",
    "dev:backend": "bun --watch backend/src/index.ts",
    "dev:frontend": "pnpm --filter frontend dev",
    "build": "pnpm run build:backend && pnpm run build:frontend",
    "build:backend": "pnpm --filter backend build",
    "build:frontend": "pnpm --filter frontend build",
    "typecheck": "pnpm run typecheck:frontend && pnpm run typecheck:backend",
    "typecheck:frontend": "pnpm --filter frontend typecheck",
    "typecheck:backend": "pnpm --filter backend typecheck",
    "test": "pnpm run test:backend",
    "test:backend": "pnpm --filter backend test",
    "lint": "pnpm run lint:frontend && pnpm run lint:backend",
    "lint:frontend": "pnpm --filter frontend lint",
    "lint:backend": "pnpm --filter backend lint",
    "lint:fix": "pnpm run lint:frontend -- --fix && pnpm run lint:backend -- --fix",
    "generate:openapi": "bun scripts/generate-openapi.ts",
    "docker:build": "DOCKER_DEFAULT_PLATFORM=linux/amd64 docker compose build",
    "docker:up": "DOCKER_DEFAULT_PLATFORM=linux/amd64 docker compose up -d",
    "docker:dev": "DOCKER_DEFAULT_PLATFORM=linux/amd64 docker compose -f docker-compose.yml -f docker-compose.dev.yml up --build --watch",
    "docker:down": "DOCKER_DEFAULT_PLATFORM=linux/amd64 docker compose down -v",
    "docker:logs": "DOCKER_DEFAULT_PLATFORM=linux/amd64 docker compose logs -f",
    "docker:restart": "DOCKER_DEFAULT_PLATFORM=linux/amd64 docker compose restart"
  },
  "devDependencies": {
    "@types/web-push": "^3.6.4",
    "concurrently": "^9.2.1"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "dotenv": "^17.3.1",
    "web-push": "^3.6.7"
  }
}
